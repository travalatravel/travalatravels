generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  role      String    @default("USER")
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model AdminSettings {
  id           String   @id @default("default")
  passwordHash String?
  updatedAt    DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  query     String?
  referrer  String?
  userAgent String?
  ip        String?
  sessionId String
  userId    String?
  source    String   @default("client")
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
}

model Offer {
  id          String    @id @default(cuid())
  type        String
  title       String
  description String
  location    String
  city        String
  country     String
  region      String?
  image       String
  price       Float
  stars       Int?
  metadata    String?
  createdAt   DateTime  @default(now())
  bookings    Booking[]

  @@index([type])
  @@index([city])
  @@index([country])
  @@index([title])
}

model CryptoWallet {
  id              String    @id @default(cuid())
  currency        String
  label           String
  address         String
  network         String    @default("mainnet")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastModifiedBy  String?
  bookings        Booking[]

  @@index([currency])
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  offerId       String
  walletId      String?
  checkIn       DateTime?
  checkOut      DateTime?
  guests        Int           @default(2)
  rooms         Int           @default(1)
  totalPrice    Float
  status        String        @default("PENDING")
  paymentMethod String        @default("CARD")
  paymentStatus     String        @default("PENDING")
  bookingType       String        @default("PRIVATE")
  guestFirstName    String?
  guestLastName     String?
  contactEmail      String?
  contactPhone      String?
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressPostalCode String?
  addressCountry    String?
  companyName       String?
  companyVatId      String?
  estimatedArrival  String?
  specialRequests   String?
  roomPackageName   String?
  roomMealType      String?
  additionalGuests  String?
  txHash            String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer         Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  wallet        CryptoWallet? @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([paymentStatus])
}
